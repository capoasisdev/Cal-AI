{
  "expo": {
    "name": "Salado AI",
    "slug": "salado-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saladoai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salado.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FCF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.salado.ai"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FCF2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Salado AI uses the camera to read the calories and macros in your meal."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Salado AI reads the calories and macros from meal photos you pick."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
